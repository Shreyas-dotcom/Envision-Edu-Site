---
layout: base.njk
title: Home
navSection: home
bodyClass: home
---
<section class="hero">
  <img class="hero__bg" src="{{ '133d6d_9a1eb5a044cf45b7a6c12f74d24a8e1a' | img }}" alt="" fetchpriority="high">
  <div class="hero__text">
    <h1>ENVISION EDUCATION</h1>
    <p class="hero__tag">BRIDGING THE DIGITAL DIVIDE</p>
    <p class="hero__lede">{{ site.description }}</p>
    <p class="hero__actions">
      <a class="btn btn--light" href="#trips">See our work</a>
      <a class="btn btn--ghost" href="/donate/">Get involved</a>
    </p>
  </div>
</section>

<section class="split split--left">
  <div class="split__media">
    <img src="{{ '1dfaf6_53881bbb8f3c40e9afc9b595befefd14' | img }}" {{ '1dfaf6_53881bbb8f3c40e9afc9b595befefd14' | imgSize | safe }} alt="A student's fingers with smiley faces drawn on them" loading="lazy">
  </div>
  <div class="split__card reveal">
    <h2 class="display">EMPOWERING DIGITAL LITERACY FOR ALL</h2>
    <p>Envision Education is an initiative launched by high school students in 2022 to bring digital learning to locations with insufficient technology resources for students. We set up computer labs and technology hubs in schools, enabling students to access global resources and widen their opportunities through digital literacy.</p>
  </div>
</section>

<section class="split split--right">
  <img class="split__laptop" src="{{ '1dfaf6_a11e30912bee4bd0b14fbeda27a13936' | img }}" alt="" loading="lazy">
  <div class="split__card reveal">
    <h2 class="display">CONNECTING COMMUNITIES AND COMPUTERS</h2>
    <p>Our mission is to provide laptops and tablets to schools and students, connecting them with limitless knowledge at their fingertips. With the global movement of digitalization, it is essential for learners in rural and remote locations to also gain global information, increase exposure to the online world, and learn real-world technology skills. Through technology, we hope to enable students to envision bigger goals and brighter futures.</p>
  </div>
  <div class="split__media">
    <img src="{{ '1dfaf6_e8e09d39be7f45a2990026367dfe27c8' | img }}" {{ '1dfaf6_e8e09d39be7f45a2990026367dfe27c8' | imgSize | safe }} alt="A student looking at a computer screen" loading="lazy">
  </div>
</section>

<section class="impact">
  <img class="impact__bg" src="{{ '2ddd8d_9f1e59bc904f43768493b7cdae495439' | img }}" alt="" loading="lazy">
  <h2 class="display">ENVISIONING OUR IMPACT</h2>
  <dl class="impact__stats">
    <div><dt>Students Reached</dt><dd data-count="1100">1100+</dd><dd class="impact__note">in the schools where we've built labs</dd></div>
    <div><dt>Teachers Trained</dt><dd data-count="55">55</dd><dd class="impact__note">at our partner schools</dd></div>
    <div><dt>Computers Donated</dt><dd data-count="180">180+</dd><dd class="impact__note">collected, shipped and set up by our team</dd></div>
    <div><dt>Technology Labs</dt><dd data-count="6">6</dd><dd class="impact__note">TanBo, LVA, Koseli, Chandi Devi, AUM and Meizhou</dd></div>
  </dl>
</section>

<section class="timeline" id="trips" aria-labelledby="trips-title">
  <header class="timeline__head">
    <h2 class="display" id="trips-title">OUR JOURNEY</h2>
    <p>One lab at a time, from our first trip to Guangdong in 2023 to today.</p>
  </header>
  <ol class="timeline__list">
    {% for trip in trips %}
    <li class="trip-row">
      <p class="trip-row__year" aria-hidden="true">{{ trip.year }}</p>
      <div class="trip-row__media">
        {% set slides = trip.slides %}{% set label = trip.name + " photos" %}
        {% include "partials/slideshow.njk" %}
      </div>
      <div class="trip-row__text reveal">
        <p class="eyebrow">{{ trip.place }}</p>
        <h3 class="display">{{ trip.name | upper }}</h3>
        <p>{{ trip.summary }}</p>
        {% include "partials/trip-stats.njk" %}
        <p class="trip-row__links">
          <a class="read-more" href="/projects/{{ trip.slug }}/">SEE THE PROJECT <svg class="arrow" viewBox="0 0 48 12" aria-hidden="true"><path d="M0 6h46M41 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></a>
          {% if trip.video %}<a class="text-link" href="/projects/{{ trip.slug }}/#film">Watch the film</a>{% endif %}
        </p>
      </div>
    </li>
    {% endfor %}
  </ol>
</section>

<section class="partners">
  <svg class="edge edge--arcs" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0h1440v160C1200 40 960 0 720 0S240 40 0 160z" fill="#7d1817"/>
    <path d="M0 160C240 54 480 18 720 18s480 36 720 142" fill="none" stroke="#e5abab" stroke-width="16"/>
    <path d="M0 160C240 70 480 38 720 38s480 32 720 122" fill="none" stroke="#e8e6e6" stroke-width="16"/>
  </svg>
  <h2 class="display">OUR PARTNERS</h2>
  <ul class="partners__logos">
    {% for p in partners %}
    <li><img src="{{ p.image | img }}" alt="{{ p.name }}" loading="lazy"></li>
    {% endfor %}
  </ul>
</section>

<section class="quotes" data-quotes aria-roledescription="carousel" aria-label="What our team says">
  {% for t in testimonials %}
  <figure class="quote{% if loop.first %} is-active{% endif %}" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ testimonials.length }}">
    <img class="quote__bg" src="{{ t.image | img }}" alt="" loading="lazy">
    <div class="quote__box">
      <blockquote>{{ t.quote }}</blockquote>
      <figcaption>{{ t.by }}</figcaption>
    </div>
  </figure>
  {% endfor %}
  <button class="quotes__btn quotes__btn--prev" aria-label="Previous quote"><svg viewBox="0 0 16 32"><path d="M15 1 1 16l14 15" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
  <button class="quotes__btn quotes__btn--next" aria-label="Next quote"><svg viewBox="0 0 16 32"><path d="m1 1 14 15L1 31" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
  <div class="quotes__dots">
    {% for t in testimonials %}<button aria-label="Show quote {{ loop.index }}"{% if loop.first %} aria-current="true"{% endif %}></button>{% endfor %}
  </div>
</section>

{% include "partials/contact.njk" %}
