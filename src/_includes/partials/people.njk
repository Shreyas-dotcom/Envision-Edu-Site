{# expects: people #}
<div class="people__grid">
  {% for p in people %}
  <article class="person">
    <img src="{{ p.image | thumb }}" alt="{{ p.name }}" loading="lazy">
    <div class="person__body">
      <h3>{{ p.name }}</h3>
      <p class="role">{{ p.role }}</p>
      <p class="bio">{{ p.bio }}</p>
    </div>
  </article>
  {% endfor %}
</div>
