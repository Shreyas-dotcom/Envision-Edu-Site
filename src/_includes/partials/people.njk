{# expects: people, cols (2|3) #}
<div class="people__grid{% if cols == 3 %} people__grid--3{% endif %}">
  {% for p in people %}
  <article class="person">
    <img src="{{ p.image | img }}" alt="{{ p.name }}" loading="lazy">
    <h3>{{ p.name }}</h3>
    <p class="role">{{ p.role }}</p>
    <p class="bio">{{ p.bio }}</p>
  </article>
  {% endfor %}
</div>
