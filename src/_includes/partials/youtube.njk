{# Lightweight YouTube embed: shows the thumbnail and only loads YouTube when clicked. expects: video {id,title} #}
<div class="yt" data-yt="{{ video.id }}">
  <button class="yt__poster" aria-label="Play video: {{ video.title }}">
    <img src="https://i.ytimg.com/vi/{{ video.id }}/hqdefault.jpg" alt="" loading="lazy">
    <span class="yt__title">{{ video.title }}</span>
    <span class="yt__play" aria-hidden="true"><svg viewBox="0 0 68 48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.3.3 34 .3 34 .3s-21.3 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 12.9.1 24 .1 24s0 11.1 1.4 16.3a8.5 8.5 0 0 0 6 6C12.7 47.7 34 47.7 34 47.7s21.3 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35.1 67.9 24 67.9 24s0-11.1-1.4-16.3z" fill="#f00"/><path d="M45 24 27 14v20z" fill="#fff"/></svg></span>
  </button>
</div>
