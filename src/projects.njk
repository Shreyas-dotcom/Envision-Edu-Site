---
layout: base.njk
title: Projects
navSection: projects
permalink: /projects/
---
<section class="projects-hero">
  <h1 class="display">PROJECTS</h1>
  <p>"Discover how Envision Education is bridging the digital divide—one school, one lab, one future at a time. Explore our past and ongoing impact across Nepal and China."</p>
</section>
{% for p in trips %}
<section class="project{% if loop.index is even %} project--flip{% endif %}">
  <div class="project__inner">
    <a class="project__media" href="/projects/{{ p.slug }}/" tabindex="-1" aria-hidden="true"><img src="{{ p.cover | img }}" alt="" loading="lazy"></a>
    <div class="project__card">
      <p class="eyebrow">{{ p.place }} · {{ p.year }}</p>
      <h2 class="display">{{ p.name | upper }}</h2>
      <p>{{ p.projectText }}</p>
      {% set trip = p %}{% include "partials/trip-stats.njk" %}
      <a class="btn" href="/projects/{{ p.slug }}/">See the project</a>
    </div>
  </div>
</section>
{% endfor %}
<section class="projects-films">
  <h2 class="display">TELENVISION</h2>
  <p>Short films from our trips.</p>
  <a class="btn" href="/telenvision/">Watch the films</a>
</section>
